{
  "manifest_version": 3,
  "name": "OpenRouter Account Status",
  "version": "1.0.0",
  "description": "View your OpenRouter account status directly from the popup - no API key needed",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
